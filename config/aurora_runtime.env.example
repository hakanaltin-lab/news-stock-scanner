# AURORA V8.9.5 safe runtime defaults
# Copy to a VPS-only environment file with restrictive permissions.
# Do not commit secrets or real account IDs.

AURORA_RUN_MODE=SAFE_OFF

AURORA_IBKR_ENABLED=false
AURORA_IBKR_MODE=PAPER
AURORA_IBKR_HOST=127.0.0.1
AURORA_IBKR_PORT=4002
AURORA_IBKR_CLIENT_ID=82
AURORA_IBKR_TIMEOUT_SECONDS=8

# Set only on the VPS after the real IBKR Paper account is known.
AURORA_IBKR_PAPER_ACCOUNT_ALLOWLIST=DUXXXXXXX

# LIVE mode intentionally does not exist in V8.9.x.

# V8.9.6 dry-run safety limits
AURORA_DRY_RUN_MAX_ORDER_NOTIONAL_USD=100
AURORA_DRY_RUN_MAX_DAILY_GROSS_NOTIONAL_USD=500
AURORA_DRY_RUN_MAX_SPREAD_BPS=50

# V8.9.7 G3 IBKR real-time market-data probe
AURORA_IBKR_MARKET_DATA_ENABLED=false
AURORA_IBKR_MARKET_DATA_CLIENT_ID=83
AURORA_IBKR_MARKET_DATA_TIMEOUT_SECONDS=8
AURORA_IBKR_MARKET_DATA_PROBE_OUTPUT=runtime/ibkr_market_data/latest.json
