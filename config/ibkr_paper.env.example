# AURORA V8.9.5 — IBKR Paper Gateway read-only environment
# Copy values into the VPS shell/session. Do NOT commit credentials or real account IDs.

AURORA_RUN_MODE=READ_ONLY
AURORA_IBKR_ENABLED=true
AURORA_IBKR_MODE=PAPER
AURORA_IBKR_HOST=127.0.0.1
AURORA_IBKR_PORT=4002
AURORA_IBKR_CLIENT_ID=82
AURORA_IBKR_TIMEOUT_SECONDS=8

# Configure the real paper account ID only on the VPS/runtime environment.
# Example placeholder only — do not commit the real value:
AURORA_IBKR_PAPER_ACCOUNT_ALLOWLIST=DUXXXXXXX
